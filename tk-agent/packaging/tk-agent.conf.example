# /etc/tk-agent.conf — mode 600, root:root (holds MQTT credentials).
# The same file works on every PC: kids are timekpr's users (`timekpra --userlist`),
# and the PC's id comes from its host name.

[broker]
# With the Mosquitto add-on: the Home Assistant host, port 1883, and the HA user
# shared by all PCs (Settings → People → Users).
host = <ha-host>
port = 1883
username = tk-agent
password = <ha-user-password>

[agent]
# Poll/report interval in seconds (30..60).
interval_s = 45
# state_dir = /var/lib/tk-agent
# Only if the host name is unsuitable ([a-z0-9_-]+ after lower-casing, must differ from every user name):
# host_id = <client-host>

# Remote-desktop links reported to Home Assistant (optional): Wayland sessions get
# rdp://<kid>@<host>:<rdp_port>, X11 sessions vnc://<host>:<vnc_base_port + display number>.
# host defaults to this PC's host name; set a host name or an IPv4 address (not IPv6)
# the parents' PCs can reach.
# [remote]
# host = <client-host>
# rdp_port = 3389
# vnc_base_port = 5900
